# Copy these into your host's environment variables (Vercel: Project → Settings → Environment
# Variables; Netlify: Site settings → Environment variables). Never commit real values —
# .env files are git-ignored. Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── AI + search providers ───────────────────────────────────────────────
GROQ_API_KEY=
TAVILY_API_KEY=

# ── Signing secrets (long random strings, all different from each other) ─
OWNER_TOKEN_SECRET=
KNOWURA_USER_TOKEN_SECRET=

# ── Owner unlock ─────────────────────────────────────────────────────────
OWNER_PASSWORD=
# First-time security-key registration only; remove once your key is registered.
WEBAUTHN_SETUP_SECRET=
RP_ID=knowura.vercel.app
ORIGIN=https://knowura.vercel.app

# ── Google sign-in (the client ID is public by design; it's also in index.html) ─
GOOGLE_CLIENT_ID=

# ── Storage (Netlify Blobs; on Vercel attach a private Blob store instead) ─
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# ── Optional tuning ──────────────────────────────────────────────────────
# Extra origins (comma-separated) allowed to call the API; same-origin is always allowed.
ALLOWED_ORIGINS=
# Message caps per person (owner mode is never limited): each allowance lasts LIMIT_WINDOW_HOURS.
LIMIT_WINDOW_HOURS=5
LIMIT_GUEST=60
LIMIT_USER=150
LIMIT_VOICE=40
# Global daily circuit breaker across everyone, and a per-minute burst limit per person.
LIMIT_GLOBAL_DAILY=5000
LIMIT_BURST_PER_MIN=10
# Set to a millisecond timestamp to invalidate every user session issued before it.
KNOWURA_TOKEN_REVOKE_BEFORE=
